{
    "name": "@twelveten/api",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file-if-exists=../../.env.local src/local.ts",
        "db:migrate": "tsx --env-file-if-exists=../../.env.local src/db/cli.ts migrate",
        "db:seed": "tsx --env-file-if-exists=../../.env.local src/db/cli.ts seed",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.8",
        "@twelveten/shared": "*",
        "hono": "^4.13.14",
        "kysely": "^0.29.7",
        "pg": "^8.23.1",
        "sanitize-html": "^2.18.1",
        "uuid": "^14.0.3",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "@types/pg": "^8.23.1",
        "@types/sanitize-html": "^2.16.2",
        "tsx": "^4.23.15"
    }
}
