{
    "name": "twelveten",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "npm run dev -w apps/web",
        "build": "npm run build --workspaces --if-present",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "npm run build -w apps/web && playwright test"
    },
    "devDependencies": {
        "@playwright/test": "1.65.0",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": ">=22"
    }
}
